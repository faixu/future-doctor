rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid 
          && data.email is string 
          && data.email.size() <= 128
          && (data.xp == 0 || data.xp > 0)
          && data.level is number;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && isValidId(userId);
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'level', 'streak', 'totalStudyHours', 'photoURL', 'displayName', 'updatedAt'])
      );
    }

    // Questions (Read-only for all, Admin write)
    match /questions/{questionId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(questionId);
    }

    // Mock Tests configurations
    match /mockTests/{testId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(testId);
    }

    // Test Results
    match /results/{resultId} {
      function isValidResult(data) {
        return data.userId == request.auth.uid
          && data.score is number && data.score <= 720
          && data.correct is number && data.totalQuestions is number;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(resultId);
      allow create: if isSignedIn() && isValidResult(incoming()) && isValidId(resultId);
    }

    // AI Doubts
    match /doubts/{doubtId} {
      function isValidDoubt(data) {
        return data.userId == request.auth.uid
          && data.query is string && data.query.size() <= 2000;
      }

      allow list: if isOwner(resource.data.userId);
      allow get: if isOwner(resource.data.userId) && isValidId(doubtId);
      allow create: if isSignedIn() && isValidDoubt(incoming()) && isValidId(doubtId);
    }
  }
}
